<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<Deterministic>false</Deterministic>
	<AssemblyVersion>1.1.1</AssemblyVersion>
	<PackageVersion>1.1.1</PackageVersion>
  </PropertyGroup>

  <PropertyGroup>
	<PackageReadmeFile>nugetREADME.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
	<None Include="nugetREADME.md" Pack="true" PackagePath="\">
	  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	</None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SQLServerInteraction.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="SQLServerInteraction.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <PropertyGroup>
	<TargetFramework>net9.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
	<Title>SQLServerInteraction</Title>
	<Authors>WilliamSmithE</Authors>
	<Copyright>William Smith (WilliamSmithE)</Copyright>
	<Description>Helper methods over Microsoft.Data.SqlClient for SQL Server: queries into DataTables, scalars and mapped objects, parameterized commands, transactions, bulk copy, insert, update and delete from dictionaries, CSV export, backup and restore, and schema lookups. The data methods have async versions. Table names, column names and conditions are inserted into the SQL as written.</Description>
	<PackageProjectUrl>https://github.com/WilliamSmithEdward/SQLServerInteraction</PackageProjectUrl>
	<RepositoryUrl>https://github.com/WilliamSmithEdward/SQLServerInteraction</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	<PackageTags>sql;sqlserver;sql-server;sqlclient;microsoft.data.sqlclient;ado.net;bulk-copy;sqlbulkcopy;wrapper;helper;async</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
	<GenerateDocumentationFile>True</GenerateDocumentationFile>
	<PackageIcon>SQLServerInteraction.png</PackageIcon>
  </PropertyGroup>
	
</Project>
