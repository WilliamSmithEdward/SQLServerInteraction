<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<Deterministic>false</Deterministic>
	<AssemblyVersion>3.0.0</AssemblyVersion>
	<PackageVersion>3.0.0</PackageVersion>
  </PropertyGroup>

  <PropertyGroup>
	<PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
	<None Include="../README.md" Pack="true" PackagePath="\">
	  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	</None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SQLServerInteraction.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="SQLServerInteraction.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <PropertyGroup>
	<TargetFramework>net9.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
	<Title>SQLServerInteraction</Title>
	<Authors>WilliamSmithE</Authors>
	<Copyright>William Smith (WilliamSmithE)</Copyright>
	<Description>Helper methods over Microsoft.Data.SqlClient for SQL Server: queries into DataTables, scalars and mapped objects, parameterized commands, transactions, bulk copy, merge, insert, update and delete from dictionaries, CSV export, backup and restore, and schema lookups. The data methods have async versions. Values are sent as parameters and table, column and index names are quoted as identifiers.</Description>
	<PackageProjectUrl>https://github.com/WilliamSmithEdward/SQLServerInteraction</PackageProjectUrl>
	<RepositoryUrl>https://github.com/WilliamSmithEdward/SQLServerInteraction</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	<PackageTags>sql;sqlserver;sql-server;sqlclient;microsoft.data.sqlclient;ado.net;bulk-copy;sqlbulkcopy;wrapper;helper;async</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
	<GenerateDocumentationFile>True</GenerateDocumentationFile>
	<PackageIcon>SQLServerInteraction.png</PackageIcon>
  </PropertyGroup>
	
</Project>
